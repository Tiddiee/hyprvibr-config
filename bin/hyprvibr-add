#!/usr/bin/env bash
#
# hyprvibr-add - add or remove Hyprvibr app rules.
#
#   hyprvibr-add        pick open Hyprland windows and add them to the rules file
#   hyprvibr-add -r     pick existing rules and remove them from the rules file
#
# Rule format:   initialClass | saturation # comment
#
# Rules are written using the window's initialClass (the class it had when it
# first opened), which stays fixed even if the live "class" changes later.
#
# Requires: hyprctl, jq   (optional: fzf for multi-select picker)

set -u

RULES_FILE="$HOME/.config/hypr/addons/hyprvibr-app-rules.lua.conf"
DEFAULT_SAT="2.2"

# ---------- helpers ----------
die() { printf 'Error: %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
Usage: hyprvibr-add [option]

  (no option)      Add open windows to the Hyprvibr rules file
  -r, --remove     Remove existing rules from the Hyprvibr rules file
  -h, --help       Show this help
EOF
}

# Return 0 if the class already has an active (non-comment) rule
class_exists() {
    local cls="$1"
    [[ -f "$RULES_FILE" ]] || return 1
    awk -F'|' -v c="$cls" '
        /^[[:space:]]*#/ { next }
        NF >= 2 {
            f = $1; gsub(/^[[:space:]]+|[[:space:]]+$/, "", f)
            if (f == c) { found = 1 }
        }
        END { exit !found }
    ' "$RULES_FILE"
}

is_number() { [[ "$1" =~ ^[0-9]+([.][0-9]+)?$ ]]; }

ask_reload() {
    read -rp "Reload Hyprland now (hyprctl reload)? [y/N]: " rl
    if [[ "$rl" =~ ^[Yy]$ ]]; then
        hyprctl reload && echo "Reloaded."
    else
        echo "Skipped reload. Run 'hyprctl reload' when ready."
    fi
}

# ---------- remove mode ----------
remove_mode() {
    [[ -f "$RULES_FILE" ]] || die "Rules file not found: $RULES_FILE"

    # initialClass of currently open windows (optional, only used for marking)
    declare -A OPEN=()
    if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 \
       && [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
        while IFS= read -r c; do
            [[ -n "$c" ]] && OPEN["$c"]=1
        done < <(hyprctl -j clients 2>/dev/null | jq -r '.[].initialClass')
    fi

    # Parse active rules: lineno <TAB> class <TAB> saturation <TAB> comment
    local R_LINES=() R_CLASSES=() R_SATS=() R_COMMENTS=()
    local ln cls sat com
    while IFS=$'\t' read -r ln cls sat com; do
        R_LINES+=("$ln"); R_CLASSES+=("$cls"); R_SATS+=("$sat"); R_COMMENTS+=("$com")
    done < <(
        awk '
            function trim(s) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", s); return s }
            /^[[:space:]]*#/ { next }
            /^[[:space:]]*$/ { next }
            {
                i = index($0, "|")
                if (i == 0) next
                cls  = trim(substr($0, 1, i - 1))
                rest = substr($0, i + 1)
                h = index(rest, "#")
                if (h > 0) { sat = trim(substr(rest, 1, h - 1)); com = trim(substr(rest, h + 1)) }
                else       { sat = trim(rest); com = "" }
                if (cls == "") next
                printf "%d\t%s\t%s\t%s\n", NR, cls, sat, com
            }
        ' "$RULES_FILE"
    )

    [[ ${#R_LINES[@]} -gt 0 ]] || { echo "No active rules found in $RULES_FILE"; exit 0; }

    # Build display labels
    local LABELS=() i mark
    for i in "${!R_LINES[@]}"; do
        mark=""
        [[ -n "${OPEN[${R_CLASSES[$i]}]:-}" ]] && mark="  [open]"
        LABELS+=("$(printf '%-30s │ %-5s │ %s%s' "${R_CLASSES[$i]}" "${R_SATS[$i]}" "${R_COMMENTS[$i]}" "$mark")")
    done

    # Selection -> list of line numbers to delete
    local DEL_LINES=()

    if command -v fzf >/dev/null 2>&1; then
        mapfile -t PICKED < <(
            for i in "${!R_LINES[@]}"; do
                printf '%s\t%s\n' "${R_LINES[$i]}" "${LABELS[$i]}"
            done \
            | fzf --multi --delimiter=$'\t' --with-nth=2 \
                  --header='Remove rules | Tab = select/deselect | Enter = confirm | Esc = cancel' \
                  --prompt='Rules > ' \
            | cut -f1
        )
        DEL_LINES=("${PICKED[@]}")
    else
        echo
        echo "Existing rules (initialClass | saturation | comment):"
        echo "------------------------------------------------------------"
        for i in "${!LABELS[@]}"; do
            printf '%3d) %s\n' "$((i+1))" "${LABELS[$i]}"
        done
        echo "------------------------------------------------------------"
        read -rp "Select numbers to remove (e.g. 1 3 5 or 1,3,5), or Enter to cancel: " input
        input="${input//,/ }"
        local n
        for n in $input; do
            if [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#R_LINES[@]} )); then
                DEL_LINES+=("${R_LINES[$((n-1))]}")
            else
                echo "Ignoring invalid selection: $n"
            fi
        done
    fi

    if [[ ${#DEL_LINES[@]} -eq 0 ]]; then
        echo "Nothing selected. Exiting."
        exit 0
    fi

    # Show what will be deleted and confirm
    echo
    echo "The following rule(s) will be DELETED from $RULES_FILE:"
    local dl
    for dl in "${DEL_LINES[@]}"; do
        for i in "${!R_LINES[@]}"; do
            [[ "${R_LINES[$i]}" == "$dl" ]] && { echo "  - ${R_CLASSES[$i]} | ${R_SATS[$i]}"; break; }
        done
    done
    read -rp "Proceed? [y/N]: " ok
    [[ "$ok" =~ ^[Yy]$ ]] || { echo "Cancelled."; exit 0; }

    # Delete by line number (only plain integers ever reach sed)
    local expr=""
    for dl in "${DEL_LINES[@]}"; do
        [[ "$dl" =~ ^[0-9]+$ ]] && expr+="${dl}d;"
    done
    sed -i --follow-symlinks "$expr" "$RULES_FILE" || die "Failed to edit $RULES_FILE"

    echo "Removed ${#DEL_LINES[@]} rule(s)."
    ask_reload
    exit 0
}

# ---------- argument parsing ----------
case "${1:-}" in
    "")            ;;
    -r|--remove)   remove_mode ;;
    -h|--help)     usage; exit 0 ;;
    *)             usage >&2; exit 1 ;;
esac

# ---------- add mode ----------
for cmd in hyprctl jq; do
    command -v "$cmd" >/dev/null 2>&1 || die "'$cmd' is not installed or not in PATH."
done

[[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || die "Hyprland doesn't appear to be running in this session."

# ---------- collect windows ----------
# Uses the same data as: hyprctl -j clients | jq '.[] | {title, class, initialClass}'
# Deduplicated by initialClass, empty initialClass dropped.
# CLASSES holds the initialClass (the value written to the rules file);
# LIVE holds the window's current class, shown only when it differs.
mapfile -t ROWS < <(
    hyprctl -j clients 2>/dev/null \
    | jq -r '[.[] | {title, class, initialClass}]
             | map(select(.initialClass != "" and .initialClass != null))
             | unique_by(.initialClass)
             | .[]
             | [.initialClass,
                (if (.class // "") == "" then .initialClass else .class end),
                (.title // "")] | @tsv'
)

[[ ${#ROWS[@]} -gt 0 ]] || die "No open windows found."

CLASSES=(); LIVE=(); TITLES=()
for row in "${ROWS[@]}"; do
    IFS=$'\t' read -r init cur title <<<"$row"
    CLASSES+=("$init"); LIVE+=("$cur"); TITLES+=("$title")
done

# ---------- selection ----------
SELECTED=()

if command -v fzf >/dev/null 2>&1; then
    # fzf picker: Tab to toggle, Enter to confirm
    mapfile -t PICKED < <(
        for i in "${!CLASSES[@]}"; do
            note=""
            class_exists "${CLASSES[$i]}" && note="  [already in rules]"
            extra=""
            [[ "${LIVE[$i]}" != "${CLASSES[$i]}" ]] && extra="  (class: ${LIVE[$i]})"
            # initialClass <TAB> display text
            printf '%s\t%-35s │ %s%s%s\n' "${CLASSES[$i]}" "${CLASSES[$i]}" "${TITLES[$i]}" "$extra" "$note"
        done \
        | fzf --multi --delimiter=$'\t' --with-nth=2 \
              --header='Tab = select/deselect | Enter = confirm | Esc = cancel' \
              --prompt='Windows > ' \
        | cut -f1
    )
    SELECTED=("${PICKED[@]}")
else
    echo
    echo "Open windows (initialClass | title):"
    echo "------------------------------------------------------------"
    for i in "${!CLASSES[@]}"; do
        note=""
        class_exists "${CLASSES[$i]}" && note="  [already in rules]"
        extra=""
        [[ "${LIVE[$i]}" != "${CLASSES[$i]}" ]] && extra="  (class: ${LIVE[$i]})"
        printf '%3d) %-30s | %s%s%s\n' "$((i+1))" "${CLASSES[$i]}" "${TITLES[$i]}" "$extra" "$note"
    done
    echo "------------------------------------------------------------"
    read -rp "Select numbers (e.g. 1 3 5 or 1,3,5), or Enter to cancel: " input
    input="${input//,/ }"
    for n in $input; do
        if [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#CLASSES[@]} )); then
            SELECTED+=("${CLASSES[$((n-1))]}")
        else
            echo "Ignoring invalid selection: $n"
        fi
    done
fi

if [[ ${#SELECTED[@]} -eq 0 ]]; then
    echo "Nothing selected. Exiting."
    exit 0
fi

# ---------- add each selection ----------
mkdir -p "$(dirname "$RULES_FILE")"
touch "$RULES_FILE"

# Make sure the file ends with a newline so we don't append onto the last line
if [[ -s "$RULES_FILE" && -n "$(tail -c1 "$RULES_FILE")" ]]; then
    echo >> "$RULES_FILE"
fi

ADDED=0
echo
for cls in "${SELECTED[@]}"; do
    # find title for default comment
    title=""
    for i in "${!CLASSES[@]}"; do
        [[ "${CLASSES[$i]}" == "$cls" ]] && { title="${TITLES[$i]}"; break; }
    done

    echo "=== $cls ==="

    if class_exists "$cls"; then
        read -rp "  '$cls' already has a rule. Add another anyway? [y/N]: " dup
        [[ "$dup" =~ ^[Yy]$ ]] || { echo "  Skipped."; echo; continue; }
    fi

    # saturation
    while true; do
        read -rp "  Saturation [$DEFAULT_SAT]: " sat
        sat="${sat:-$DEFAULT_SAT}"
        is_number "$sat" && break
        echo "  Please enter a number (e.g. 1.5)."
    done

    # comment
    read -rp "  Comment [${title}]: " comment
    comment="${comment:-$title}"
    comment="${comment//$'\n'/ }"

    printf '%s | %s # %s\n' "$cls" "$sat" "$comment" >> "$RULES_FILE"
    echo "  Added: $cls | $sat # $comment"
    echo
    ((ADDED++))
done

if (( ADDED == 0 )); then
    echo "No rules were added."
    exit 0
fi

echo "Added $ADDED rule(s) to $RULES_FILE"

# ---------- reload ----------
ask_reload
